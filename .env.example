# Copy to .env and fill in. Git ignores .env.
AWS_REGION=your-aws-region
AWS_PROFILE=example_project_dev
AWS_ACCOUNT_ID=your-aws-account-id
PROJECT_NAME=healthcare_surgical_risk_streaming
ENVIRONMENT=dev
# The project's one bucket, for the Terraform state and all data under prefixes. Appears in no tracked file.
S3_BUCKET=your-bucket-name

# The project's one private Docker Hub repository, <account>/<repository>, which holds every project image. make images-push reads it, and the host pulls them with the account
# part. Lowercase letters and digits for the account; no registry host, tag or digest. Appears in no tracked code or test.
# IMAGE_REPOSITORY=youraccount/your-repository

# From the Tailscale console, Trust credentials, for the host's federated identity. Neither is a secret. The IAM role boundary also reads the audience.
# TAILSCALE_CLIENT_ID=your-client-id
# TAILSCALE_AUDIENCE=your-audience

# Path of the private key that signs evidence receipts. The key exists on the owner's computer only.
# EVIDENCE_VERIFIER_KEY=~/.ssh/example_evidence_verifier

# Read by `make group-up` and `make group-down` and by the Dagster code location, from the process environment or the compose folder's host.env. None is a secret.
# STACK_COMPOSE_DIRECTORY=/opt/platform/compose
# COMPOSE_PROJECT_NAME=surgical_risk
# STACK_K3S_NAMESPACE=airbyte
# STACK_K3S_RELEASE=airbyte
# STACK_K3S_API=https://k3s_api:6443
# STACK_K3S_TOKEN_FILE=/run/secrets/k3s_token
# STACK_K3S_CA_FILE=/run/secrets/k3s_ca
# Test input of the admission check, in MiB: replaces the reading of the host's available memory.
# STACK_TEST_AVAILABLE_MIB=30000
