# Copy to .env and fill in. Git ignores .env.
AWS_REGION=your-aws-region
AWS_PROFILE=example_project_dev
AWS_ACCOUNT_ID=your-aws-account-id
PROJECT_NAME=healthcare_surgical_risk
ENVIRONMENT=dev

# From the Tailscale console, Trust credentials, for the host's federated identity. Neither is a secret.
# TAILSCALE_CLIENT_ID=your-client-id
# TAILSCALE_AUDIENCE=your-audience
