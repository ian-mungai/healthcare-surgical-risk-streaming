{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}",
        "arn:aws:s3:::${S3_BUCKET}-test-*"
      ]
    },
    {
      "Sid": "ProjectBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}",
        "arn:aws:s3:::${S3_BUCKET}-test-*"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "landing/*",
            "warehouse/*",
            "manifests/*"
          ]
        }
      }
    },
    {
      "Sid": "ProjectRecordCopyListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}",
        "arn:aws:s3:::${S3_BUCKET}-test-*"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "records_input/*"
          ]
        }
      }
    },
    {
      "Sid": "ProjectDataObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}/landing/*",
        "arn:aws:s3:::${S3_BUCKET}/warehouse/*",
        "arn:aws:s3:::${S3_BUCKET}-test-*/landing/*",
        "arn:aws:s3:::${S3_BUCKET}-test-*/warehouse/*"
      ]
    },
    {
      "Sid": "ProjectManifestObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}/manifests/*",
        "arn:aws:s3:::${S3_BUCKET}-test-*/manifests/*"
      ]
    },
    {
      "Sid": "ProjectRecordCopyObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}/records_input/*",
        "arn:aws:s3:::${S3_BUCKET}-test-*/records_input/*"
      ]
    },
    {
      "Sid": "PublisherBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::physionet-open",
        "arn:aws:s3:::physionet-open/vitaldb/1.0.0/*"
      ]
    },
    {
      "Sid": "ShortIdentityTokens",
      "Effect": "Allow",
      "Action": "sts:GetWebIdentityToken",
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "sts:IdentityTokenAudience": "${TAILSCALE_AUDIENCE}"
        },
        "Null": {
          "sts:IdentityTokenAudience": "false"
        },
        "NumericLessThanEquals": {
          "sts:DurationSeconds": "300"
        }
      }
    },
    {
      "Sid": "AssumeProjectWorkloadRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_workload_*"
    }
  ]
}
